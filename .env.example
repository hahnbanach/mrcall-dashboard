# Template for the per-environment files (.env.production, .env.beta, .env.test,
# .env.development). Those are NOT in git, and must not be added.
#
# Deploys write the real file from a secret held on the environment; see
# .github/workflows/deploy.yml. Locally, copy this to .env.development and fill in
# the blanks.
#
# Everything here ships to the browser: vue-cli inlines every VUE_APP_* value into
# the public bundle whether the code reads it or not. Nothing that must stay secret
# can live in this file. The Firebase web keys below are public identifiers by
# design, protected by Security Rules and authorized domains, not by being hidden.
#
# The Google OAuth client secret is not here and must never be: it is held by the
# backend, which performs the authorization-code exchange.

VUE_APP_I18N_LOCALE=en-US
VUE_APP_I18N_FALLBACK_LOCALE=en-US
VUE_APP_I18N_SUPPORTED_LOCALES=en-US,it-IT,fr-FR,es-ES,de-DE,da-DK,el-GR,es-ES,et-EE,fi-FI,nb-NO,nl-NL,sv-SE
VUE_APP_STARCHAT_URL=https://api.mrcall.ai
VUE_APP_MRZ_DOMAIN=api.mrcall.ai
VUE_APP_SERVICE_BASE_URL=https://dashboard.mrcall.ai
VUE_APP_PUBLIC_PATH=
VUE_APP_STRIPE_USER_PORTAL=https://billing.stripe.com/p/login/eVacPi32X8CD60UeUU
VUE_APP_WEBSITE_BASE_URL=https://www.mrcall.ai
VUE_APP_GOOGLE_REDIRECT_URI=https://dashboard.mrcall.ai/callback
VUE_APP_GOOGLE_CLIENT_ID=375340415237-8hiphso6n86hd35lnhu4vc7m4fsb1mvh.apps.googleusercontent.com
# There is no VUE_APP_GOOGLE_CLIENT_SECRET here, and there must not be one in any
# .env file, not even commented out. vue-cli inlines every VUE_APP_* value into the
# bundle, so a secret in one of these files is one uncommented line away from being
# published to every visitor. The secret lives only in StarChat, which performs
# the code exchange. See docs/integration/google-oauth.md
VUE_APP_FIREBASE_API_KEY=
VUE_APP_FIREBASE_AUTH_DOMAIN=talkmeapp-e696c.firebaseapp.com
VUE_APP_FIREBASE_PROJECT_ID=talkmeapp-e696c
VUE_APP_FIREBASE_STORAGE_BUCKET=talkmeapp-e696c.appspot.com
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=375340415237
VUE_APP_FIREBASE_APP_ID=1:375340415237:web:d0551e6e27d341eb7f9f6c
VUE_APP_FIREBASE_MEASUREMENT_ID=G-Q5HNTEV6DH
VUE_APP_ZYLCH_URL=https://zylch.mrcall.ai
VUE_APP_META_APP_ID=YOUR_FACEBOOK_APP_ID_HERE
