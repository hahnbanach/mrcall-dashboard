{
  "name": "mrcall",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "@achrinza/node-ipc": {
      "node": ">=8.0.0"
    }
  },
  "resolutions": {
    "whatwg-url": "^14.1.0"
  },
  "scripts": {
    "serve": "vue-cli-service serve --no-cache",
    "build": "vue-cli-service build",
    "lint": "eslint \"src/**/*.{js,vue}\" --fix",
    "i18n:report": "vue-i18n-extract --vueFiles \"./src/**/*.?(js|vue)\" --languageFiles \"src/i18n/locales/**/*.json\"",
    "sitemap": "vue-cli-service sitemap",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:update-snapshots": "npx playwright test --update-snapshots",
    "test:unit": "npm run lint:check && vitest run",
    "test:unit:watch": "vitest",
    "lint:check": "eslint \"src/**/*.{js,vue}\""
  },
  "dependencies": {
    "@mrcall/directvoice": "^1.0.5",
    "@primevue/themes": "^4.2.5",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "1.21.0",
    "chart.js": "^4.5.1",
    "core-js": "^3.39.0",
    "firebase": "^11.3.0",
    "json-editor-vue": "^0.17.3",
    "libphonenumber-js": "^1.11.17",
    "maz-ui": "^3.50.1",
    "opusscript": "^0.1.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "rxjs": "^7.8.1",
    "secure-ls": "^2.0.0",
    "vue": "^3.4.21",
    "vue-gtag": "^2.0.1",
    "vue-i18n": "11.4.14",
    "vue-meta": "^3.0.0-alpha.10",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0",
    "vuex-persist": "^3.1.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^10.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "less": "^4.2.1",
    "less-loader": "^12.2.0",
    "vite": "6.4.6",
    "vitest": "^4.1.12",
    "vue-cli-plugin-compression": "~2.0.0",
    "vue-cli-plugin-sitemap": "^2.0.2",
    "vue-i18n-extract": "^2.0.7",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "license": "MIT"
}
